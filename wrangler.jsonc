{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "db-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public"
  },
  "observability": {
    "enabled": true
  }
}
